.toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }

.toast-item { padding: 14px 22px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); font-size: 0.9rem; font-weight: 500; color: rgb(255, 255, 255); display: flex; align-items: center; gap: 10px; animation: 0.3s ease 0s 1 normal none running slideInRight; pointer-events: auto; max-width: 360px; }

