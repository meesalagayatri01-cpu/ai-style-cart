.navbar-logo { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--color-primary); white-space: nowrap; display: flex; align-items: center; gap: 2px; }

.navbar-logo span { color: var(--color-secondary); }

.navbar-search { flex: 1 1 0%; max-width: 480px; position: relative; }

.navbar-search-input { width: 100%; padding: 10px 16px 10px 42px; border: 1.5px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-alt); font-size: 0.9rem; transition: var(--transition); }

