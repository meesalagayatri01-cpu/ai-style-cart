.mobile-drawer-close:hover { background: var(--color-bg-alt); }

.footer { background: var(--color-primary); color: var(--color-text-inverse); padding: 56px 0px 24px; margin-top: auto; }

.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 40px; }

