.product-card-name { font-size: 0.95rem; font-weight: 500; color: var(--color-text); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.product-card-rating { display: flex; align-items: center; gap: 4px; font-size: 0.8rem; color: var(--color-text-muted); }

